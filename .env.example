# OpenAI / DevScale gateway (required for agent + evals)
OPENAI_API_KEY=
# Base URL without the path suffix (SDK appends /chat/completions)
# Example: https://gateway.devscale.id/v1
OPENAI_BASE_URL=https://gateway.devscale.id/v1
# Model id exposed by the gateway
OPENAI_MODEL=gpt-6-luna
# chat = /v1/chat/completions (DevScale) | responses = /v1/responses
OPENAI_API=chat

# Tavily (required for web search tools; optional for evals)
TAVILY_API_KEY=

# PostgreSQL (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
